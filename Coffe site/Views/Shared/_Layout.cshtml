

<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title class="text-black-50">@ViewData["Title"] - Coffe site</title>
     <link rel="icon" type="image/x-icon" href="/favicon.ico"> 
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Coffe_site.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm header-all">
            <div class="container-fluid ">

                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-mug-hot icon3"></i>  Coffe site
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav  ms-auto">


                        <li class="nav-item me-1">
                            <a class="nav-link navbar-hover "><i class="fa-solid fa-phone"></i> 8 800 200-710-7</a>
                        </li>



                        <li class="nav-item me-4">
                            <a class="nav-link navbar-hover" data-bs-toggle="modal" data-bs-target="#myModal" id="RegLoginBar">Вход</a>
                        </li>
                        <li class="nav-item me-4">
                            <a class="nav-link navbar-hover" asp-area="" asp-controller="Home" asp-action="Account" id="accBar">Аккаунт</a>
                        </li>
                        <li class="nav-item  me-4">
                            <a class="nav-link navbar-hover" asp-area="" asp-controller="Home" asp-action="Index">Главная</a>
                        </li>
                        <li class="nav-item  me-4">
                            <a class="nav-link navbar-hover" asp-area="" asp-controller="Home" asp-action="Privacy">О нас</a>
                        </li>
                        <li class="nav-item  me-4">
                            <a class="nav-link navbar-hover" asp-area="" asp-controller="Home" asp-action="Sells">Акции</a>
                        </li>

                        <li class="nav-item  me-4">
                            <a class="nav-link navbar-hover" asp-area="" asp-controller="Home" asp-action="Main">Кофе</a>
                        </li>

                        <li class="nav-item  me-4 ">
                            <a class="nav-link navbar-hover" asp-area="" asp-controller="Home" asp-action="Desserts">Десерты</a>
                        </li>
                        <li class="nav-item  me-4 ">
                            <a class="nav-link navbar-hover" asp-area="" asp-controller="Home" asp-action="Cart">Корзина</a>
                        </li>
                       @*  <li class="nav-item  me-4 ">
                            <a class="nav-link navbar-hover" asp-area="" asp-controller="Home" asp-action="OrderStory">История заказов</a>
                        </li>
                        <li class="nav-item  me-4 ">
                            <a class="nav-link navbar-hover" asp-area="" asp-controller="Home" asp-action="OrderDone">Пуста</a>
                        </li> *@
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class=" footer text-black">
        <div class="container">
          <div class="row">
              <div class="col-md-9 d-flex flex-column justify-content-around align-items-baseline">
                  <h4 class="text-black mb-3 m-3">
                        <i class="fa-solid fa-mug-hot icon3"></i> Coffe Site
                  </h4>

                  <div class="container">
                     <div class="row">
                  <div class="col-md-4">
                      <p>
                            Каллорийность и состав
                      </p>
                        <p>
                            Франшиза
                        </p>
                  </div>
                    <div class ="col-md-4">
                        <p>
                                    Правовая информация
                                </p>
                        <p>
                            Главная
                        </p>
                  </div>
                    <div class="col-md-4">
                        <p>
                        Помощь

                        </p>
                        <p>
                            Работа в Coffe Site
                        </p>
                  </div>
                        </div>
                    </div>
                  
                    <small>
                        ©Кофейня Coffe site. Все права защищены.
                    </small>
              </div>
                <div class="col-md-3 d-flex flex-column justify-content-around align-items-baseline">
                    <h4 class="text-black">
                        Контакты
                    </h4>
             
                    <p>
                        <i class="fa-solid fa-phone"></i>
                        8 800 200-710-7
                    </p>
                    <p>
                        <i class="fa-solid fa-envelope"></i> mail@coffesite.ru
                    </p>
                </div>
          </div>
        </div>
    </footer>

    <script src="~/js/global.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.2.1/dist/jquery.min.js" type="text/javascript"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery.maskedinput@1.4.1/src/jquery.maskedinput.min.js" type="text/javascript"></script>
    @await RenderSectionAsync("Scripts", required: false)


  
    <div class="modal fade align-content-center" id="myModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="false">
        <div class="modal-dialog">
            <div class="modal-content modal_enter">
                <div class="modal-body">
                    <div class="mb-4">
                        <div class="mb-4">
                            <h4 class="text-black margin_for_modal">Вход в аккаунт</h4>
                        </div>
                        
                        <div class="mb-4">
                            <input type="text" class="form-control textbox" id="phone-login" placeholder="Телефон">
                        </div>
                        <div class="mb-4">
                            <input type="text" class="form-control textbox" id="password-login" placeholder="Пароль">
                        </div>
                        <div class="mb-1">
                            <h15 class="validate-css" id="validateTextLogin"></h15>
                        </div>
                        <div class="mb-4">
                
                            <a style="cursor:pointer;"
                               class="text-muted text-light"
                               data-bs-toggle="modal" data-bs-target="#ModalForRegistration">
                                Нет аккаунта? Нажмите для регистрации
                            </a>
                           

                        </div>
                        <button type="submit" class="btn modal_btn float-end margin_for_modal_btn me-2">Войти</button>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="modal fade align-content-center" id="ModalForRegistration" tabindex="-1" aria-labelledby="registrationModalLabel" aria-hidden="false">
        <div class="modal-dialog">
            <div class="modal-content modal_enter2">
                <div class="modal-body">
                    <div class="mb-4">
                        <div class="mb-4">
                            <h4 class="text-black margin_for_modal">Регистрация</h4>
                        </div>
                       
                        <div class="mb-4">
                            <input type="text" class="form-control textbox" id="phone-reg" placeholder="Телефон">
                        </div>
                        <div class="mb-4">
                            <input type="text" class="form-control textbox" id="password-reg" placeholder="Пароль">
                        </div>

                        <div class="mb-1">
                        <h15 class="validate-css" id="validateText"></h15>
                        </div>

                        <div class="mb-4">
                            <div class="text-black text-light">
                                Предоставляя личные данные, Вы соглашаетесь
                                с условиями обработки персональных данных
                            </div>
                        </div>
                        <div class="mb-4">
                          
                            <a style="cursor:pointer;"
                               class="text-muted text-light"
                               data-bs-toggle="modal" data-bs-target="#myModal" >
                                Уже есть аккаунт? Войти
                            </a>
                           
                        </div>
                        <button type="submit" class="btn modal_btn2 margin_for_modal_btn justify-content-center" id="btnReg">Зарегистрироваться</button>
                    </>
                </div>
            </div>
        </div>
    </div>
    </div>



</body>
</html>


