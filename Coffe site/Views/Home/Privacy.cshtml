@{
    ViewData["Title"] = "Privacy Policy";

    var color = ViewBag.PageColor ?? "#FFF1D6";

}

<style>
    body{
        background-color:@color;
    }
</style>

<div class="first-page">

<div class="container">
        <h1 class="hheader">
    Уникальность в проффесионализме
</h1>
    <h2>
    Мы гордимся нашей командой – настоящими профессионалами своего дела, чей талант подтвержден многочисленными наградами!
</h2>
    <div class="card-body justify-content-center paddind-reward">
            <img class="card-img-top" src="~/lib/meta/ряд.png" alt="Rewards">
    </div>
</div>
</div>

<h1>
    Удобный адрес в центре Москвы
</h1>
<div class="container">
    <div class="row">
      
        <div class="col-md-8">
            <img class="card-img map" src="~/lib/meta/Screenshot 2025-08-20 171905.png" alt="Map">
            <h2 class="d-flex align-items-baseline"> 
                <i class="fa-solid fa-location-dot icon"></i>
                Садовническая улица, 24 ст6а 
            </h2>
            <h2>
                С 9:00 до 21:00
            </h2>
        </div>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
        <div class="col-md-4 d-flex  flex-column justify-content-center align-items-center">
            <h2 class="mb-3 text-center">
                Приятный интерьер
            </h2>
            <img class="card-img room" src="~/lib/meta/iwmwab1337tzuv1yewmvkz0jdhdmz5f5.jpg" alt="Photo of room">
        </div>
    </div>
</div>


<div class="second-page">
    <h1 class="margin-privacy">
    Наши сотрудники
</h1>
    <h2 class="d-flex align-items-baseline">
        <i class="fa-solid fa-person icon2 margin-privacy"></i>
    Познакомьтесь с командой Coffe Site
</h2>


    <div class="container">
        <div class="row">
    <div class="col-md-4">
        <div class="card box-shadow emp">
                    <img class="card-img-top face" src="~/lib/meta/чувихаа.jpg" alt="Human">
            <div class="card-body ">
                <h4 class="card-text">
                            Анастасия
                            Овчиникова
                </h4>
                <p class="card-text">
                            Специалист с 4-летним опытом обжарки и приготовления кофе. Имеет множество
                            наград и достижений.
                        </p>
            </div>
        </div>
        </div>
            <div class="col-md-4">
                <div class="card box-shadow emp">
                    <img class="card-img-top face" src="~/lib/meta/ел.jpg" alt="Human">
                    <div class="card-body">
                        <h4 class="card-text">
                            Антон Воробьёв
                        </h4>
                        <p class="card-text">
                            Специалист с 5-летним опытом работы
                            кондитера. Разбирается в тонкостях
                            приготовления даже самых сложных
                            десертов
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card box-shadow emp">
                    <img class="card-img-top face" src="~/lib/meta/челиха.jpg" alt="Human">
                    <div class="card-body">
                        <h4 class="card-text">
                            Алёна Афанасьева
                        </h4>
                        <p class="card-text">
                            Специалист с 8-летним стажем работы бариста. Профессионал в варке качественного и вкусного кофе
                        </p>
                    </div>
                </div>
            </div>
    </div>
</div>
</div>